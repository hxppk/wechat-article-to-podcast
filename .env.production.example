# ==== 瘦云端 .env：只跑 API/前端/任务队列/音频托管，零 AI key、零代理 ====
# 所有 AI（Claude claude -p / MiniMax / ElevenLabs / 文章抽取）在本地 worker，
# 见 LOCAL-WORKER-SETUP.md。云端不需要任何 AI key、不需要 mihomo 代理。

# ---- 服务 ----
PORT=8080

# ---- 安全（用 openssl rand -hex 32 生成）----
JWT_SECRET=
CORS_ORIGIN=https://podcast.hxppk.cn

# ---- 本地 worker 鉴权（与本地 .env.worker 的 WORKER_API_TOKEN 相同强随机值）----
WORKER_API_TOKEN=

# ---- 任务 lease 可见性超时（毫秒，worker 心跳续约）----
LEASE_MS=120000

# ---- 清理任务 ----
DISABLE_CLEANUP=false
