# ============================================================
# 本地 worker 环境变量 —— 全部 AI key 在此
# 拉模式：轮询云端认领任务 → 本地抽取/脚本/音频生成 → 上传回云端。
# 纯出站，无需暴露端口。
# 运行：npm run worker  （或 pm2 start worker.js）
# ============================================================

# 云端 API 基址（必填）
CLOUD_API_BASE=https://your-cloud-host.example.com

# 与云端一致的 Bearer Token（必填）
WORKER_API_TOKEN=change-me-shared-worker-token

# 本 worker 标识（可选，默认 worker-<hostname>）
WORKER_ID=worker-local-1

# 轮询间隔（毫秒，无任务时的 sleep，可选，默认 5000）
WORKER_POLL_MS=5000

# 租约时长（毫秒，需与云端一致；heartbeat 频率 = LEASE_MS/3）
LEASE_MS=120000

# 并发任务数（可选，默认 1，先串行）
WORKER_CONCURRENCY=1

# ---------- MiniMax TTS（ttsProvider=minimax 时使用，默认） ----------
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_VOICE_A=Chinese (Mandarin)_Southern_Young_Man
MINIMAX_VOICE_B=Chinese (Mandarin)_Crisp_Girl

# ---------- ElevenLabs TTS（ttsProvider=elevenlabs 时使用） ----------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_A=DowyQ68vDpgFYdWVGjc3
ELEVENLABS_VOICE_B=ByhETIclHirOlWnWKhHc
# 可选: ELEVENLABS_MODEL=eleven_v3 / ELEVENLABS_LANGUAGE=cmn /
#        ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128 / ELEVENLABS_MAX_CONCURRENT=1

# ---------- Claude CLI（脚本生成，使用本机 claude 登录态，免 API key） ----------
# 可选: CLAUDE_MODEL=claude-opus-4-8 / CLAUDE_BIN=claude /
#        CLAUDE_TIMEOUT_MS=120000 / CLAUDE_MAX_CONCURRENT=1 / CLAUDE_ALLOW_API_KEY=0
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_CONCURRENT=1

# 代理（可选，用于访问 ElevenLabs / MiniMax；本地住宅 IP 通常直连即可）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
