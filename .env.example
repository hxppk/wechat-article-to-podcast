# Gemini API Key (必填，使用 Gemini TTS 时)
GEMINI_API_KEY=your_gemini_api_key_here

# TTS 供应商 (可选，默认 gemini，可选 minimax)
TTS_PROVIDER=gemini

# MiniMax TTS 配置 (TTS_PROVIDER=minimax 时必填)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_VOICE_A=Chinese (Mandarin)_Southern_Young_Man
MINIMAX_VOICE_B=Chinese (Mandarin)_Crisp_Girl

# 服务端口 (可选，默认 3000)
PORT=3000

# 代理设置 (可选，用于访问 Google API)
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
