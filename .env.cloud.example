# ============================================================
# 云端（瘦服务）环境变量 —— 零 AI key
# 只做：前端 / 接收请求 / 任务队列(db) / worker API / 音频托管播放
# 所有 AI（Claude / MiniMax / ElevenLabs）都在本地 worker，云端不含任何 AI key。
# ============================================================

# 服务端口（可选，默认 3000）
PORT=3000

# 用户登录 JWT 密钥（必填，请改成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-secret

# 本地 worker 调用 /api/worker/* 的 Bearer Token（必填，需与 worker 端一致）
WORKER_API_TOKEN=change-me-shared-worker-token

# 任务租约时长（毫秒，可选，默认 120000）
# worker 认领后须在此时间内 heartbeat 续约，否则任务可被重新认领。
LEASE_MS=120000

# 代理（可选，云端一般不需要）
# HTTPS_PROXY=
# HTTP_PROXY=
